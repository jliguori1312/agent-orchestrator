{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  // src + test are both type-checked together; vitest executes TS directly, so
  // no emit-layout options yet — they return when a real build script lands.
  "include": ["src/**/*", "test/**/*", "vitest.config.ts"]
}
