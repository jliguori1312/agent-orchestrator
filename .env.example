# agent-orchestrator — dev-only convenience (NOT the host mechanism).
#
# On the host, secrets are files under /etc/agent-orchestrator/ loaded by the
# systemd unit via LoadCredential= (ADR-0004) — never environment variables.
# This file exists only to run the orchestrator manually during M1 development,
# outside systemd. Copy to `.env` (gitignored) if your dev runner reads it.
# Secrets never live in this repo — keep them on the host only.

# GitHub App — the private key is a FILE, never a value here (ADR-0003).
GH_APP_PRIVATE_KEY_PATH=/etc/agent-orchestrator/app.pem

# Model-provider key for the triage/plan/implement/review roles.
ANTHROPIC_API_KEY=

# Read-only Cloudflare token — verify.sh needs it for types:fresh. Never a
# deploy/write token (SEC3).
CLOUDFLARE_API_TOKEN=
