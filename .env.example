# agent-orchestrator environment (copy to `.env`, which is gitignored).
# Secrets never live in this repo — keep them on the host only.

# GitHub App identity (ADR-0003). The private key is a file, never a value here.
GH_APP_ID=
GH_APP_PRIVATE_KEY_PATH=/etc/agent-orchestrator/app.pem
GH_APP_INSTALLATION_ID=

# Model provider for the triage/plan/implement roles
MODEL_PROVIDER=
IMPLEMENT_MODEL=

# Different model for the adversarial review role (build plan D5)
REVIEW_MODEL=

# Where target repos are cloned and worktrees are created
WORKSPACE_ROOT=/var/lib/agent-orchestrator

# Command run inside each target repo's worktree to decide "green" (G2 / P4)
VERIFY_COMMAND=./scripts/agent/verify.sh
