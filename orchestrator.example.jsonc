// orchestrator.example.jsonc — copy to orchestrator.jsonc (gitignored) and fill in.
// Host config. Per-target-repo policy lives in each target repo's .github/agent.yml.

{
  "target": {
    "repo": "owner/your-repo",   // first target repository
    "base": "main"               // branch worktrees freeze from
  },

  "github_app": {
    "app_id": "123456",          // numeric GitHub App ID (public, not secret)
    "installation_id": "789012"  // installation ID for the target repo (public, not secret)
    // The App private key is NOT here — on the host it is a systemd credential
    // (LoadCredential=, ADR-0004); see docs/config-reference.md.
  },

  "workspace": {
    "root": "/var/lib/agent-orchestrator"   // repos cloned + worktrees created here
  },

  "model": {
    "provider": "anthropic",      // ONE key-based provider (a pi provider id); the host
                                   // loads its key as "<provider>-key" (e.g. anthropic-key)
    "triage": "claude-...",        // model for the triage role
    "plan": "claude-...",          // model for the plan role
    "implement": "claude-...",     // model for the implement role
    "review": "claude-..."         // model for the adversarial review role
                                   // (a different model on the same provider — build plan D5)
  },

  "verify": {
    "command": "./scripts/agent/verify.sh"  // run inside each target worktree
  },

  "guardrails": {
    "protected_paths": "scripts/agent/protected-paths.txt",  // path inside the target repo
    "diff_budget_lines": 300,
    "diff_budget_files": 10
  },

  "notify": {
    // No separate channel. `needs-human` rides the GitHub App's @mentions through
    // GitHub's native mobile/email delivery (ADR-0003).
  }
}
